# Normalise line endings so re-running the collectors on Windows does not make
# every data file appear modified. Without this, `git status` reports 100+
# changed CSVs whose content is byte-identical apart from CR characters, which
# makes the repository diff unreadable for a reviewer.
* text=auto eol=lf

# Data files: text, LF in the repository, so diffs reflect real changes only.
*.csv   text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.toml  text eol=lf

# Binary assets: never diff or normalise.
*.png   binary
*.svg   text eol=lf
*.docx  binary
*.pdf   binary
*.xlsx  binary
